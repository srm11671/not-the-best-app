# --- Supabase ---
# Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Dashboard > Settings > API > Project API keys > service_role
# NEVER expose this to the browser. Used only by the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...

# Dashboard > Product catalog > your product > pricing
STRIPE_PRICE_ID=price_...

# Dashboard > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
